DirectoryIndex index.html

# FastCGI на REG.RU может не передать Authorization в PHP без этой переменной.
SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1

<IfModule mod_rewrite.c>
  RewriteEngine On

  # REG.RU ставит nginx-прокси перед Apache: HTTPS определяем по forwarded header.
  RewriteCond %{HTTP_HOST} !^indoor-golf\.ru$ [NC,OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://indoor-golf.ru%{REQUEST_URI} [R=301,L,NE]

  # Вспомогательные PHP-модули никогда не доступны из браузера.
  RewriteRule ^api/_.*\.php$ - [R=404,L,NC]

  # Существующие файлы и каталоги, включая assets и /invitational/, отдаём как есть.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Старый адрес раздела технологий ведём на канонический /tech.
  RewriteRule ^technology/?$ /tech [R=301,L,NC]

  # Для основных маршрутов postbuild создаёт HTML с уникальными SEO-метаданными.
  RewriteRule ^(about|tech|gallery|services|events|contacts|privacy|consent|legal|terms|tournament-rules)/?$ $1.html [L,NC]

  # Любой неизвестный адрес получает настоящий HTTP 404 и нашу страницу ошибки.
  RewriteRule ^ - [R=404,L]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-src https://yandex.ru https://*.yclients.com"

  <FilesMatch "\.(?:css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(?:webp|png|jpe?g|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
