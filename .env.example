# Необязательный публичный аварийный выключатель iframe YClients.
# Если переменная не задана, онлайн-запись включена. Для отключения задайте false.
VITE_YCLIENTS_EMBED_ENABLED=true

# Секреты TG_BOT_TOKEN, TG_CHAT_ID и YCLIENTS_WEBHOOK_KEY должны задаваться
# только в серверном окружении PHP-FPM/nginx и никогда не иметь префикс VITE_.
